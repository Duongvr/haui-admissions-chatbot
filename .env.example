# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=haui_admissions

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=haui-admissions-model
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_PORT=11434

# Open WebUI Configuration
WEBUI_HOST=0.0.0.0
WEBUI_PORT=3000
WEBUI_DATA_PATH=./open-webui/data

# Application Configuration
DEBUG=False
LOG_LEVEL=INFO

# RAG Pipeline
PDF_UPLOAD_PATH=./data/uploads
PROCESSED_DATA_PATH=./open-webui/data
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_THRESHOLD=0.7
TOP_K_RESULTS=5

# Vector Store (ChromaDB - tích hợp sẵn trong Open WebUI)
CHROMADB_HOST=127.0.0.1
CHROMADB_PORT=8000
